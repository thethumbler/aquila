@@ -1161,10 +1160,17 @@ term(void)
         write(termfd, startprogram, strlen(startprogram));
         write(termfd, "\r", 1);
     }
+    /* drawing goes to the window's buffer even before it's mapped (and a
+     * buffered window gets no exposure events): read at once */
+    GrRegisterInput(termfd);
+
     while (42) {
         if (havefocus)
             draw_cursor();
 
+        /* show what was drawn in the buffer */
+        GrFlushWindow(w1);
