+    /* buffered: the server keeps the window's contents and redraws what
+     * another window uncovers, as the text isn't kept here */
+    w1 = GrNewWindowEx(GR_WM_PROPS_APPWINDOW | GR_WM_PROPS_BUFFERED, TITLE,
+                       GR_ROOT_WINDOW_ID, -1, -1, winw, winh, stdbackground);
 
     GrSelectEvents(w1, GR_EVENT_MASK_BUTTON_DOWN | GR_EVENT_MASK_EXPOSURE |
                    GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_FOCUS_IN |
